---
import { existsSync } from 'node:fs';
import path from 'node:path';
import { SAMPLE, SAMPLE_FR } from '../data/audio';

interface Props { locale?: 'en' | 'fr' }
const { locale = 'en' } = Astro.props as Props;
const C = locale === 'fr' ? SAMPLE_FR : SAMPLE;

/* import.meta.url is virtualised during the Vite SSR build, so resolve from the
   project root instead — otherwise the player silently never renders. */
const hasAudio = existsSync(path.join(process.cwd(), 'public', SAMPLE.file));
---

<div class="audio-card" id="sample-call">
  <h3>{hasAudio ? C.title : C.fallbackTitle}</h3>
  <p class="audio-sub">{C.sub}</p>
  {
    hasAudio && (
      <audio controls preload="none" src={SAMPLE.file} aria-label={C.audioLabel}>
        {C.noSupport} <a href={SAMPLE.file}>{C.download}</a>
      </audio>
    )
  }
  <ul class="audio-lines">
    {
      C.lines.map((l) => (
        <li class={l.dulce ? 'dulce' : ''}>
          <span class="who">{l.who}</span>
          <p class="said" lang="fr">{l.said}</p>
          <p class="tr" lang="es">{l.tr}</p>
        </li>
      ))
    }
  </ul>
</div>
