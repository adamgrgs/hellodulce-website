---
import Base from '../../layouts/Base.astro';
import { APP_URL, SITE } from '../../data/site';
import { CORE_QA_FR, FACTS_FR, STEPS_FR, USE_CASES_FR, UI_FR } from '../../data/fr';
import { altForRoute, routePath, useCasePath } from '../../data/i18n';

const title = 'FAQ Hello Dulce : comment fonctionne l’interprète téléphonique IA';
const description =
  'Des réponses claires : ce qu’est Hello Dulce, la vitesse de la traduction, si ça sonne robotique, les langues couvertes, le prix, et la comparaison avec un service d’interprétation.';

const useCaseFaqs = USE_CASES_FR.flatMap((u) => u.faqs.map((f) => ({ ...f, from: u.title, slug: u.slug })));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    name: title,
    url: new URL('/fr/faq', SITE.domain).href,
    inLanguage: 'fr-CA',
    mainEntity: [...CORE_QA_FR, ...useCaseFaqs].map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/fr', SITE.domain).href },
      { '@type': 'ListItem', position: 2, name: 'FAQ', item: new URL('/fr/faq', SITE.domain).href },
    ],
  },
];
---

<Base title={`${title} | Hello Dulce`} description={description} path="/fr/faq" jsonLd={jsonLd} locale="fr" alternates={altForRoute('faq')}>
  <section class="sec">
    <div class="wrap">
      <p class="crumbs"><a href="/fr">Accueil</a> / FAQ</p>
      <p class="kicker">Questions et réponses</p>
      <h1>Tout ce qu’on demande avant son premier appel</h1>
      <p class="lede">
        Des réponses courtes, en langage clair. Si quelque chose reste flou ici, c’est un défaut de
        cette page, pas le vôtre.
      </p>

      <ul class="facts facts-4">
        {
          FACTS_FR.map((f) => (
            <li>
              <span class="v">{f.value}</span>
              <span class="l">{f.label} &mdash; {f.note}</span>
            </li>
          ))
        }
      </ul>

      <div style="margin-top:44px;max-width:78ch">
        {
          CORE_QA_FR.map((f) => (
            <section id={f.slug} style="margin-bottom:30px">
              <h2 style="font-size:clamp(1.15rem,4.4vw,1.4rem)">{f.q}</h2>
              <p style="color:#f0e2d6;line-height:1.7;margin:0">{f.a}</p>
            </section>
          ))
        }
      </div>

      <h2 style="margin-top:52px">Les quatre étapes, encore</h2>
      <div class="steps" style="margin-top:18px">
        {
          STEPS_FR.map((s) => (
            <div class="step">
              <span class="n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>

      <h2 style="margin-top:52px">Questions sur des appels précis</h2>
      <section class="faq" style="margin-top:18px;max-width:78ch">
        {
          useCaseFaqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
              <p style="font-size:.86rem"><a href={useCasePath(f.slug, 'fr')}>En savoir plus : {f.from.toLowerCase()} &rarr;</a></p>
            </details>
          ))
        }
      </section>

      <div class="band" style="margin-top:52px">
        <h2>Prête quand vous l’êtes</h2>
        <p>Rien à télécharger pour vous, rien du tout pour la personne que vous appelez.</p>
        <a class="btn" href={APP_URL}>{UI_FR.cta.startArrow}</a>
      </div>
    </div>
  </section>
</Base>
