---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { SITE, APP_URL } from '../../../data/site';
import { UI_FR } from '../../../data/fr';
import { altForRoute } from '../../../data/i18n';

const posts = (await getCollection('blog'))
  .filter((p) => p.id.startsWith('fr/'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const title = 'Guides sur les appels par-dessus la barrière linguistique | Hello Dulce';
const description =
  'Des guides pratiques et sourcés sur l’interprétation téléphonique, les barrières linguistiques en santé, et comment parler aux écoles et aux institutions dans une langue que vous ne parlez pas.';

const frPath = (id: string) => `/fr/guides/${id.replace('fr/', '')}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Guides Hello Dulce',
    url: new URL('/fr/guides', SITE.domain).href,
    inLanguage: 'fr-CA',
    description,
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      url: new URL(frPath(p.id), SITE.domain).href,
      datePublished: p.data.publishDate.toISOString().slice(0, 10),
      dateModified: p.data.updatedDate.toISOString().slice(0, 10),
      inLanguage: 'fr-CA',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/fr', SITE.domain).href },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/fr/guides', SITE.domain).href },
    ],
  },
];
---

<Base title={title} description={description} path="/fr/guides" jsonLd={jsonLd} locale="fr" alternates={altForRoute('blog')}>
  <section class="sec">
    <div class="wrap">
      <p class="crumbs"><a href="/fr">Accueil</a> / Guides</p>
      <p class="kicker">Guides</p>
      <h1>Faire l’appel, quand l’appel est dans une autre langue</h1>
      <p class="lede">
        Des guides sourcés et pratiques : ce que coûte vraiment l’interprétation téléphonique, ce que
        dit la recherche sur les barrières linguistiques en santé, et comment obtenir une réponse d’un
        secrétariat qui ne répond qu’en français.
      </p>

      <ul class="post-list" style="margin-top:34px">
        {
          posts.map((p) => (
            <li>
              <a class="card" href={frPath(p.id)} style={`border-top:3px solid ${p.data.accent}`}>
                <span style="font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--dark-muted);font-weight:800">
                  {p.data.readingMinutes} {UI_FR.labels.readTime}
                </span>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
                <span class="more">{UI_FR.cta.readGuide}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="band" style="margin-top:48px">
        <h2>Arrêtez de répéter l’appel dans votre tête</h2>
        <p>Écrivez ce que vous voulez dire dans votre langue. Hello Dulce le dit dans la leur.</p>
        <a class="btn" href={APP_URL}>{UI_FR.cta.startArrow}</a>
      </div>
    </div>
  </section>
</Base>
