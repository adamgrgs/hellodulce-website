---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { SITE, APP_URL } from '../../../data/site';
import { USE_CASES_FR, UI_FR } from '../../../data/fr';
import { altForBlog, blogEnSlug, useCasePath, routePath } from '../../../data/i18n';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => p.id.startsWith('fr/'));
  return posts.map((post) => ({ params: { slug: post.id.replace('fr/', '') }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const enSlug = blogEnSlug(post.id);
const path = `/fr/guides/${post.id.replace('fr/', '')}`;
const url = new URL(path, SITE.domain).href;
const iso = (x: Date) => x.toISOString().slice(0, 10);

const related = USE_CASES_FR.filter((u) => d.relatedUseCases.includes(u.slug));
const others = (await getCollection('blog'))
  .filter((p) => p.id.startsWith('fr/') && p.id !== post.id)
  .slice(0, 2);
const h2s = headings.filter((h) => h.depth === 2);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    datePublished: iso(d.publishDate),
    dateModified: iso(d.updatedDate),
    inLanguage: 'fr-CA',
    keywords: [d.primaryKeyword, ...d.secondaryKeywords].join(', '),
    wordCount: post.body?.split(/\s+/).length ?? undefined,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
    abstract: d.answer,
    citation: d.citations.map((c) => ({
      '@type': 'CreativeWork',
      name: c.title,
      publisher: c.publisher,
      datePublished: c.year,
      url: c.url,
    })),
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.answer', '.facts'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'fr-CA',
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/fr', SITE.domain).href },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/fr/guides', SITE.domain).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
const fmt = (x: Date) => x.toLocaleDateString('fr-CA', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title={`${d.metaTitle} | Hello Dulce`}
  description={d.description}
  path={path}
  jsonLd={jsonLd}
  locale="fr"
  articleDates={{ published: iso(d.publishDate), modified: iso(d.updatedDate) }}
  alternates={altForBlog(enSlug)}
>
  <section class="sec">
    <div class="wrap">
      <p class="crumbs">
        <a href="/fr">Accueil</a> / <a href={routePath('blog', 'fr')}>Guides</a> / {d.primaryKeyword}
      </p>
      <h1 style="max-width:22ch">{d.title}</h1>
      <p class="post-meta">
        <span>{UI_FR.labels.published} {fmt(d.publishDate)}</span>
        <span>{UI_FR.labels.updated} {fmt(d.updatedDate)}</span>
        <span>{d.readingMinutes} {UI_FR.labels.readTime}</span>
      </p>

      <div class="answer" style="max-width:72ch">
        <p class="answer-q">{UI_FR.labels.shortAnswer}</p>
        <p>{d.answer}</p>
      </div>

      <ul class="facts facts-4">
        {
          d.keyNumbers.map((k) => (
            <li>
              <span class="v">{k.value}</span>
              <span class="l">{k.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="prose" style="margin-top:40px">
        {
          h2s.length > 2 && (
            <nav class="toc" aria-label={UI_FR.labels.onThisPage}>
              <p>{UI_FR.labels.onThisPage}</p>
              <ol>
                {h2s.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          )
        }
        <Content />
      </div>

      <section class="faq" style="margin-top:52px;max-width:72ch">
        <h2 style="margin-bottom:18px">{UI_FR.labels.questionsAsked}</h2>
        {
          d.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </section>

      <section style="margin-top:48px;max-width:72ch" class="refs">
        <h2 style="font-size:1.1rem">{UI_FR.labels.sources}</h2>
        <ul style="display:grid;gap:8px;padding-left:20px">
          {
            d.citations.map((c) => (
              <li>
                [{c.id}] <a href={c.url} rel="nofollow noopener" target="_blank">{c.title}</a> &mdash; {c.publisher}, {c.year}.
              </li>
            ))
          }
        </ul>
      </section>

      {
        related.length > 0 && (
          <section style="margin-top:52px">
            <h2 style="font-size:1.2rem">{UI_FR.labels.seeTheCall}</h2>
            <ul class="post-list" style="margin-top:16px">
              {related.map((u) => (
                <li>
                  <a class="card" href={useCasePath(u.slug, 'fr')} style={`border-top:3px solid ${u.accent}`}>
                    <div class="card-emoji" aria-hidden="true">{u.emoji}</div>
                    <h2>{u.title}</h2>
                    <p>{u.intro.slice(0, 130)}&hellip;</p>
                    <span class="more">{UI_FR.cta.watchSim}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        others.length > 0 && (
          <section style="margin-top:44px">
            <h2 style="font-size:1.2rem">{UI_FR.labels.keepReading}</h2>
            <ul class="post-list" style="margin-top:16px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
              {others.map((p) => (
                <li>
                  <a class="card" href={`/fr/guides/${p.id.replace('fr/', '')}`}>
                    <h2>{p.data.title}</h2>
                    <p>{p.data.description.slice(0, 120)}&hellip;</p>
                    <span class="more">{UI_FR.cta.read}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="band" style="margin-top:52px">
        <h2>Faites l’appel dans vos mots</h2>
        <p>Vous l’écrivez dans votre langue. Dulce le dit dans la leur et vous renvoie chaque réponse.</p>
        <a class="btn" href={APP_URL}>{UI_FR.cta.startArrow}</a>
      </div>
    </div>
  </section>
</Base>
