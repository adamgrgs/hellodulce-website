---
import Base from '../../../layouts/Base.astro';
import CallDemo from '../../../components/CallDemo.astro';
import { APP_URL, SITE } from '../../../data/site';
import { USE_CASES_FR, STEPS_FR, UI_FR } from '../../../data/fr';
import { altForUseCase, useCasePath, routePath, USE_CASE_SLUGS } from '../../../data/i18n';

export function getStaticPaths() {
  return USE_CASES_FR.map((u) => ({ params: { slug: USE_CASE_SLUGS[u.slug].fr }, props: { u } }));
}
const { u } = Astro.props;
const others = USE_CASES_FR.filter((o) => o.slug !== u.slug).slice(0, 3);
const abs = (p: string) => new URL(p, SITE.domain).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/fr') },
      { '@type': 'ListItem', position: 2, name: 'Cas d’utilisation', item: abs(routePath('useCases', 'fr')) },
      { '@type': 'ListItem', position: 3, name: u.title, item: abs(useCasePath(u.slug, 'fr')) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'fr-CA',
    mainEntity: u.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title={u.metaTitle}
  description={u.metaDescription}
  path={useCasePath(u.slug, 'fr')}
  jsonLd={jsonLd}
  locale="fr"
  alternates={altForUseCase(u.slug)}
>
  <section class="hero" style={`--accent:${u.accent}`}>
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <nav class="crumbs" aria-label="Fil d’Ariane">
        <a href="/fr">Accueil</a> <span aria-hidden="true">/</span>
        <a href={routePath('useCases', 'fr')}>Cas d’utilisation</a>
        <span aria-hidden="true">/</span> <span>{u.title}</span>
      </nav>
    </div>
    <div class="wrap hero-grid">
      <div>
        <span class="kicker">{u.emoji} {u.kicker}</span>
        <h1>{u.h1}</h1>
        <p class="lede">{u.intro}</p>
        <div class="hero-cta">
          <a class="btn" href={APP_URL}>{UI_FR.cta.startArrow}</a>
          <a class="btn btn-ghost" href="#appels">Ce que vous pouvez demander</a>
        </div>
        <p class="hero-note">
          Vous écrivez en {u.scenario.yourLang}. On entend un {u.scenario.theirLang} impeccable.
        </p>
      </div>
      <div>
        <CallDemo scenario={u.scenario} accent={u.accent} id={`demo-${u.slug}`} locale="fr" />
      </div>
    </div>
  </section>

  <section class="sec" id="appels">
    <div class="wrap">
      <span class="kicker">{u.title}</span>
      <h2>Trois appels qu’on fait dès le premier jour</h2>
      <div class="cards cards-3" style="margin-top:26px">
        {u.jobs.map((j) => (
          <div class="card">
            <h3>{j.title}</h3>
            <p>{j.body}</p>
            <p class="quote-line">&laquo;&nbsp;{j.quote}&nbsp;&raquo;</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec-tight">
    <div class="wrap">
      <h2>Comment l’appel se déroule</h2>
      <div class="steps" style="margin-top:24px">
        {STEPS_FR.map((s) => (
          <div class="step">
            <div class="n">{s.n}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec-tight">
    <div class="wrap" style="max-width:820px">
      <h2>Bon à savoir</h2>
      <div class="faq">
        {u.faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="band">
        <h2>Faites cet appel aujourd’hui</h2>
        <p>Écrivez la première ligne dans votre langue. Dulce compose et parle.</p>
        <a class="btn" href={APP_URL}>{UI_FR.cta.startArrow}</a>
      </div>
      <h2 style="margin-top:56px">Les autres appels que Dulce gère</h2>
      <div class="cards cards-3" style="margin-top:20px">
        {others.map((o) => (
          <a class="card" href={useCasePath(o.slug, 'fr')}>
            <div class="card-emoji">{o.emoji}</div>
            <h3>{o.title}</h3>
            <p>{o.jobs[0].body}</p>
            <span class="more">{UI_FR.cta.seeCall}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs { font-size: 0.8rem; color: var(--dark-muted); margin-bottom: 20px; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--pink); }
  .crumbs span[aria-hidden] { padding: 0 4px; }
</style>
