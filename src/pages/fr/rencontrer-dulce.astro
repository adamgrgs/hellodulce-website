---
import Base from '../../layouts/Base.astro';
import { SITE, APP_URL } from '../../data/site';
import { DULCE_FR as DULCE } from '../../data/dulce';
import { UI_FR } from '../../data/fr';
import { altForRoute } from '../../data/i18n';
import AudioSample from '../../components/AudioSample.astro';

const title = 'Rencontrez Dulce, la voix qui fait votre appel';
const description =
  'Dulce est étudiante au cégep à Montréal, sauveteuse, et le personnage derrière Hello Dulce : patiente avec le monde, calme sous pression, curieuse de tout. Voici qui elle est.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Dulce',
    description: DULCE.oneLiner,
    image: new URL(DULCE.images.hero, SITE.domain).href,
    homeLocation: { '@type': 'Place', name: DULCE.city },
    inLanguage: 'fr-CA',
    knowsLanguage: ['fr', 'en', 'es'],
    disambiguatingDescription:
      'Dulce est un personnage fictif créé comme mascotte et voix du service d’interprétation téléphonique Hello Dulce. Ce n’est pas une personne réelle.',
    worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/fr', SITE.domain).href },
      { '@type': 'ListItem', position: 2, name: 'Rencontrer Dulce', item: new URL('/fr/rencontrer-dulce', SITE.domain).href },
    ],
  },
];
---

<Base
  title={`${title} | Hello Dulce`}
  description={description}
  path="/fr/rencontrer-dulce"
  jsonLd={jsonLd}
  locale="fr"
  alternates={altForRoute('meetDulce')}
>
  <div class="glow" aria-hidden="true"></div>

  <section class="sec">
    <div class="wrap">
      <p class="crumbs"><a href="/fr">Accueil</a> / Rencontrer Dulce</p>
      <div class="dulce-hero">
        <div>
          <p class="kicker">Rencontrer Dulce</p>
          <h1>L’amie qui <span class="em grad">fait l’appel</span> à votre place</h1>
          <p class="lede">{DULCE.oneLiner}</p>
          <div class="answer" style="margin-top:26px;max-width:60ch">
            <p class="answer-q">C’est qui, Dulce?</p>
            <p>
              Dulce a {DULCE.age} ans, vit à {DULCE.city}, étudie en techniques d’éducation spécialisée au cégep,
              travaille avec des enfants qui ont besoin de plus de patience, est sauveteuse l’été, et conduit une
              Kia Rio orange qu’elle a déjà menée plus loin que prévu. C’est un personnage, pas une personne
              réelle — mais chaque règle sur la façon dont Hello Dulce se comporte au téléphone vient d’elle.
            </p>
          </div>
          <div class="hero-cta">
            <a class="btn" href={APP_URL}>Laissez Dulce faire l’appel &rarr;</a>
            <a class="btn btn-ghost" href="#sample-call">{UI_FR.cta.hearVoice}</a>
          </div>
        </div>
        <div class="dulce-portrait">
          <img
            src={DULCE.images.hero}
            width="399"
            height="980"
            alt="Dulce, étudiante montréalaise de 18 ans en coton ouaté orange de sauveteuse, sifflet au cou et sac fourre-tout couvert d’épinglettes, au téléphone en train de saluer"
            fetchpriority="high"
          />
        </div>
      </div>

      <ul class="facts">
        {
          DULCE.facts.map((f) => (
            <li>
              <span class="l" style="margin:0 0 4px">{f.label}</span>
              <span class="v" style="font-size:1rem">{f.value}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="kicker">Sa personnalité, et pourquoi c’est le produit</p>
      <h2>Quatre choses sur Dulce qui paraissent dans chaque appel</h2>
      <div class="trait-list">
        {
          DULCE.traits.map((t) => (
            <article class="trait">
              <img src={t.image} alt={t.alt} loading="lazy" width="320" height="420" />
              <div>
                <h3><span aria-hidden="true">{t.emoji}</span> {t.title}</h3>
                <p>{t.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap" style="max-width:860px">
      <p class="kicker">Comment elle se comporte au téléphone</p>
      <h2>Les règles de Dulce</h2>
      <ol class="rules">
        {DULCE.traits && DULCE.voiceRules.map((r) => <li>{r}</li>)}
      </ol>
      <p class="quote-line" style="margin-top:26px">{DULCE.quote}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap" style="max-width:860px">
      <p class="kicker">Sa vraie voix</p>
      <h2>Voici ce que l’école a entendu</h2>
      <p class="lede" style="margin-bottom:20px">
        Écoutez la première phrase : elle se nomme, dit qu’elle est interprète virtuelle, et dit à qui
        appartient cet appel. Cette divulgation n’est pas optionnelle — c’est la règle numéro un.
      </p>
      <AudioSample locale="fr" />
    </div>
  </section>

  <section class="sec-tight">
    <div class="wrap">
      <div class="band">
        <h2>Donnez-lui un appel à faire</h2>
        <p>Écrivez-le dans votre langue. Dulce s’occupe du reste.</p>
        <a class="btn" href={APP_URL}>{UI_FR.cta.startArrow}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .dulce-hero { display: grid; gap: 30px; align-items: center; }
  @media (min-width: 940px) { .dulce-hero { grid-template-columns: 1.25fr 0.75fr; gap: 48px; } }
  .dulce-portrait { display: flex; justify-content: center; }
  .dulce-portrait img { width: min(300px, 74%); height: auto; filter: drop-shadow(0 24px 44px rgba(255, 106, 43, 0.28)); }
  .trait-list { display: grid; gap: 18px; margin-top: 22px; }
  @media (min-width: 820px) { .trait-list { grid-template-columns: repeat(2, 1fr); } }
  .trait {
    display: grid; grid-template-columns: 110px 1fr; gap: 18px; align-items: start;
    border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 20px;
    background: linear-gradient(150deg, rgba(255, 106, 43, 0.07), transparent 60%);
  }
  .trait img { width: 110px; height: auto; border-radius: 14px; }
  .trait h3 { margin: 0 0 8px; font-size: 1.06rem; }
  .trait p { color: var(--muted); font-size: 0.95rem; margin: 0; }
  .rules { display: grid; gap: 12px; margin: 20px 0 0; padding-left: 22px; }
  .rules li { color: #f0e2d6; font-size: 1.02rem; line-height: 1.6; }
</style>
