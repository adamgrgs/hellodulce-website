---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, APP_URL } from '../../data/site';
import { altForRoute } from '../../data/i18n';

const posts = (await getCollection('blog'))
  .filter((p) => !p.id.startsWith('fr/'))
  .sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const title = 'Guides to phone calls across a language barrier | Hello Dulce';
const description =
  'Practical, sourced guides on phone interpreting, language barriers in healthcare, and talking to schools and institutions in a language you do not speak.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Hello Dulce guides',
    url: new URL('/blog', SITE.domain).href,
    description,
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      url: new URL(`/blog/${p.id}`, SITE.domain).href,
      datePublished: p.data.publishDate.toISOString().slice(0, 10),
      dateModified: p.data.updatedDate.toISOString().slice(0, 10),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/blog', SITE.domain).href },
    ],
  },
];
const fmt = (d: Date) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={title} description={description} path="/blog" alternates={altForRoute('blog')} jsonLd={jsonLd}>
  <section class="sec">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / Guides</p>
      <p class="kicker">Guides</p>
      <h1>Making the call, when the call is in another language</h1>
      <p class="lede">
        Sourced, practical guides: what phone interpreting actually costs, what the evidence says about
        language barriers in healthcare, and how to get an answer out of an office that only speaks French.
      </p>

      <ul class="post-list" style="margin-top:34px">
        {
          posts.map((p) => (
            <li>
              <a class="card" href={`/blog/${p.id}`} style={`border-top:3px solid ${p.data.accent}`}>
                <span class="who" style="font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--dark-muted);font-weight:800">
                  {p.data.readingMinutes} min read
                </span>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
                <span class="more">Read the guide &rarr;</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="band" style="margin-top:48px">
        <h2>Stop rehearsing the call</h2>
        <p>Write what you want to say in your language. Hello Dulce says it in theirs.</p>
        <a class="btn" href={APP_URL}>Start a call &rarr;</a>
      </div>
    </div>
  </section>
</Base>
