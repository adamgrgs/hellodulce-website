---
import Base from '../layouts/Base.astro';
import { SITE, APP_URL, CORE_QA, FACTS, USE_CASES, STEPS } from '../data/site';
import { altForRoute } from '../data/i18n';

const title = 'Hello Dulce FAQ: how the AI phone interpreter works';
const description =
  'Straight answers about Hello Dulce: what it is, how fast the translation is, whether it sounds like a robot, which languages it covers, what it costs, and how it compares to a phone interpreter.';

const useCaseFaqs = USE_CASES.flatMap((u) => u.faqs.map((f) => ({ ...f, from: u.title, slug: u.slug })));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    name: title,
    url: new URL('/faq', SITE.domain).href,
    inLanguage: 'en',
    mainEntity: [...CORE_QA, ...useCaseFaqs].map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
      { '@type': 'ListItem', position: 2, name: 'FAQ', item: new URL('/faq', SITE.domain).href },
    ],
  },
];
---

<Base title={`${title} | Hello Dulce`} description={description} path="/faq" alternates={altForRoute('faq')} jsonLd={jsonLd}>
  <section class="sec">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / FAQ</p>
      <p class="kicker">Questions &amp; answers</p>
      <h1>Everything people ask before their first call</h1>
      <p class="lede">
        Short answers, in plain language. If something here is unclear, it is a bug in this page, not in you.
      </p>

      <ul class="facts facts-4">
        {
          FACTS.map((f) => (
            <li>
              <span class="v">{f.value}</span>
              <span class="l">{f.label} &mdash; {f.note}</span>
            </li>
          ))
        }
      </ul>

      <div style="margin-top:44px;max-width:78ch">
        {
          CORE_QA.map((f) => (
            <section id={f.slug} style="margin-bottom:30px">
              <h2 style="font-size:clamp(1.15rem,4.4vw,1.4rem)">{f.q}</h2>
              <p style="color:#e6d9f2;line-height:1.7;margin:0">{f.a}</p>
            </section>
          ))
        }
      </div>

      <h2 style="margin-top:52px">The four steps, again</h2>
      <div class="steps" style="margin-top:18px">
        {
          STEPS.map((s) => (
            <div class="step">
              <span class="n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>

      <h2 style="margin-top:52px">Questions about specific calls</h2>
      <section class="faq" style="margin-top:18px;max-width:78ch">
        {
          useCaseFaqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
              <p style="font-size:.86rem"><a href={`/use-cases/${f.slug}`}>More on {f.from.toLowerCase()} &rarr;</a></p>
            </details>
          ))
        }
      </section>

      <div class="band" style="margin-top:52px">
        <h2>Ready when you are</h2>
        <p>No download for you, nothing at all for the person you are calling.</p>
        <a class="btn" href={APP_URL}>Start a call &rarr;</a>
      </div>
    </div>
  </section>
</Base>
