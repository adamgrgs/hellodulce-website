---
import Base from '../layouts/Base.astro';
import { SITE, APP_URL } from '../data/site';
import { DULCE } from '../data/dulce';
import AudioSample from '../components/AudioSample.astro';

const title = 'Meet Dulce, the voice that makes your call';
const description =
  'Dulce is a Montreal CEGEP student, a lifeguard, and the character behind Hello Dulce: patient with people, calm under pressure, and curious about everyone. Here is who she is.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Dulce',
    description: DULCE.oneLiner,
    image: new URL(DULCE.images.hero, SITE.domain).href,
    homeLocation: { '@type': 'Place', name: DULCE.city },
    knowsLanguage: ['fr', 'en', 'es'],
    disambiguatingDescription:
      'Dulce is a fictional character created as the mascot and voice persona of the Hello Dulce phone interpretation service. She is not a real person.',
    worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
      { '@type': 'ListItem', position: 2, name: 'Meet Dulce', item: new URL('/meet-dulce', SITE.domain).href },
    ],
  },
];
---

<Base title={`${title} | Hello Dulce`} description={description} path="/meet-dulce" jsonLd={jsonLd}>
  <div class="glow" aria-hidden="true"></div>

  <section class="sec">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / Meet Dulce</p>
      <div class="dulce-hero">
        <div>
          <p class="kicker">Meet Dulce</p>
          <h1>The friend who <span class="em grad">makes the call</span> for you</h1>
          <p class="lede">{DULCE.oneLiner}</p>
          <div class="answer" style="margin-top:26px;max-width:60ch">
            <p class="answer-q">Who is Dulce?</p>
            <p>
              Dulce is {DULCE.age}, lives in {DULCE.city}, studies special care counselling at CEGEP, works with
              children who need extra patience, lifeguards in the summer, and drives an orange Kia Rio she has
              already taken further than it was designed to go. She is a character, not a real person — but every
              rule about how Hello Dulce behaves on the phone comes from her.
            </p>
          </div>
          <div class="hero-cta">
            <a class="btn" href={APP_URL}>Let Dulce make the call &rarr;</a>
            <a class="btn btn-ghost" href="#sample-call">Hear her voice</a>
          </div>
        </div>
        <div class="dulce-portrait">
          <img
            src={DULCE.images.hero}
            width="399"
            height="980"
            alt="Dulce, an 18-year-old Montreal student in an orange lifeguard hoodie with a whistle and a pin-covered tote bag, on the phone and waving"
            fetchpriority="high"
          />
        </div>
      </div>

      <ul class="facts">
        {
          DULCE.facts.map((f) => (
            <li>
              <span class="l" style="margin:0 0 4px">{f.label}</span>
              <span class="v" style="font-size:1rem">{f.value}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="kicker">Her personality, and why it is the product</p>
      <h2>Four things about Dulce that show up on every call</h2>
      <div class="trait-list">
        {
          DULCE.traits.map((t) => (
            <article class="trait">
              <img src={t.image} alt={t.alt} loading="lazy" width="320" height="420" />
              <div>
                <h3><span aria-hidden="true">{t.emoji}</span> {t.title}</h3>
                <p>{t.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap" style="max-width:860px">
      <p class="kicker">How she behaves on the phone</p>
      <h2>Dulce’s rules</h2>
      <ol class="rules">
        {DULCE.traits && DULCE.voiceRules.map((r) => <li>{r}</li>)}
      </ol>
      <p class="quote-line" style="margin-top:26px">{DULCE.quote}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap" style="max-width:860px">
      <p class="kicker">Her actual voice</p>
      <h2>This is what the school heard</h2>
      <AudioSample />
    </div>
  </section>

  <section class="sec-tight">
    <div class="wrap">
      <div class="band">
        <h2>Give her a call to make</h2>
        <p>Write it in your language. Dulce takes it from there.</p>
        <a class="btn" href={APP_URL}>Start a call &rarr;</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .dulce-hero { display: grid; gap: 30px; align-items: center; }
  @media (min-width: 940px) { .dulce-hero { grid-template-columns: 1.25fr 0.75fr; gap: 48px; } }
  .dulce-portrait { display: flex; justify-content: center; }
  .dulce-portrait img { width: min(300px, 74%); height: auto; filter: drop-shadow(0 24px 44px rgba(255, 106, 43, 0.28)); }
  .trait-list { display: grid; gap: 18px; margin-top: 22px; }
  @media (min-width: 820px) { .trait-list { grid-template-columns: repeat(2, 1fr); } }
  .trait {
    display: grid; grid-template-columns: 110px 1fr; gap: 18px; align-items: start;
    border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 20px;
    background: linear-gradient(150deg, rgba(255, 106, 43, 0.07), transparent 60%);
  }
  .trait img { width: 110px; height: auto; border-radius: 14px; }
  .trait h3 { margin: 0 0 8px; font-size: 1.06rem; }
  .trait p { color: var(--muted); font-size: 0.95rem; margin: 0; }
  .rules { display: grid; gap: 12px; margin: 20px 0 0; padding-left: 22px; }
  .rules li { color: #f0e2d6; font-size: 1.02rem; line-height: 1.6; }
</style>
