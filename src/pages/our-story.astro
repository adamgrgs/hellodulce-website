---
import Base from '../layouts/Base.astro';
import { SITE, APP_URL } from '../data/site';
import { STORY } from '../data/story';
import { altForRoute } from '../data/i18n';

const title = 'Our story';
const description =
  'Hello Dulce was built by someone who needed it. Arriving in Montreal in 2012, our founder could manage in French in person but not on the phone — and needed to ask a friend to interpret every call that mattered.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `${title} | ${SITE.name}`,
    description,
    url: new URL('/our-story', SITE.domain).href,
    about: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
      { '@type': 'ListItem', position: 2, name: title, item: new URL('/our-story', SITE.domain).href },
    ],
  },
];
---

<Base
  title={`${title} — why we built ${SITE.name} | ${SITE.name}`}
  description={description}
  path="/our-story"
  alternates={altForRoute('story')}
  jsonLd={jsonLd}
>
  <div class="glow" aria-hidden="true"></div>

  <section class="sec">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / {title}</p>
      <p class="kicker">{STORY.kicker}</p>
      <h1>{STORY.h1Lead}<br class="d-br" /><span class="em grad">{STORY.h1Accent}</span></h1>
      <p class="lede" style="max-width:64ch">{STORY.lede}</p>
    </div>
  </section>

  <section class="sec-tight">
    <div class="wrap">
      <div class="prose">
        {STORY.sections.map((s, i) => (
          <>
            <h2>{s.h}</h2>
            {s.p.map((para) => <p>{para}</p>)}
            {i === 2 && (
              <blockquote>{STORY.pull}</blockquote>
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="sec-tight">
    <div class="wrap">
      <div class="answer" style="max-width:72ch">
        <p class="answer-q">{STORY.closing.h}</p>
        <p>{STORY.closing.p}</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="band">
        <h2>Make the call you have been putting off</h2>
        <p>Write the first line in your language. Dulce says it in theirs.</p>
        <a class="btn" href={APP_URL}>Start a call &rarr;</a>
      </div>
    </div>
  </section>
</Base>
