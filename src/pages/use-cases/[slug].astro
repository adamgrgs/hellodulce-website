---
import Base from '../../layouts/Base.astro';
import CallDemo from '../../components/CallDemo.astro';
import { USE_CASES, APP_URL, STEPS } from '../../data/site';

export function getStaticPaths() {
  return USE_CASES.map((u) => ({ params: { slug: u.slug }, props: { u } }));
}
const { u } = Astro.props;
const others = USE_CASES.filter((o) => o.slug !== u.slug).slice(0, 3);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hellodulce.com/' },
      { '@type': 'ListItem', position: 2, name: 'Use cases', item: 'https://hellodulce.com/use-cases' },
      { '@type': 'ListItem', position: 3, name: u.title, item: `https://hellodulce.com/use-cases/${u.slug}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: u.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={u.metaTitle} description={u.metaDescription} path={`/use-cases/${u.slug}`} jsonLd={jsonLd}>
  <section class="hero" style={`--accent:${u.accent}`}>
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/use-cases">Use cases</a>
        <span aria-hidden="true">/</span> <span>{u.title}</span>
      </nav>
    </div>
    <div class="wrap hero-grid">
      <div>
        <span class="kicker">{u.emoji} {u.kicker}</span>
        <h1>{u.h1}</h1>
        <p class="lede">{u.intro}</p>
        <div class="hero-cta">
          <a class="btn" href={APP_URL}>Start a call &rarr;</a>
          <a class="btn btn-ghost" href="#calls">What you can ask for</a>
        </div>
        <p class="hero-note">You write in {u.scenario.yourLang}. They hear fluent {u.scenario.theirLang}.</p>
      </div>
      <div>
        <CallDemo scenario={u.scenario} accent={u.accent} id={`demo-${u.slug}`} />
      </div>
    </div>
  </section>

  <section class="sec" id="calls">
    <div class="wrap">
      <span class="kicker">{u.title}</span>
      <h2>Three calls people make on day one</h2>
      <div class="cards cards-3" style="margin-top:26px">
        {u.jobs.map((j) => (
          <div class="card">
            <h3>{j.title}</h3>
            <p>{j.body}</p>
            <p class="quote-line">&ldquo;{j.quote}&rdquo;</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec-tight">
    <div class="wrap">
      <h2>How the call runs</h2>
      <div class="steps" style="margin-top:24px">
        {STEPS.map((s) => (
          <div class="step">
            <div class="n">{s.n}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec-tight">
    <div class="wrap" style="max-width:820px">
      <h2>Good to know</h2>
      <div class="faq">
        {u.faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="band">
        <h2>Make this call today</h2>
        <p>Write the first line in your language. Dulce dials and does the talking.</p>
        <a class="btn" href={APP_URL}>Start a call &rarr;</a>
      </div>
      <h2 style="margin-top:56px">Other calls Dulce handles</h2>
      <div class="cards cards-3" style="margin-top:20px">
        {others.map((o) => (
          <a class="card" href={`/use-cases/${o.slug}`}>
            <div class="card-emoji">{o.emoji}</div>
            <h3>{o.title}</h3>
            <p>{o.jobs[0].body}</p>
            <span class="more">See the call &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs { font-size: 0.8rem; color: var(--dark-muted); margin-bottom: 20px; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--pink); }
  .crumbs span[aria-hidden] { padding: 0 4px; }
</style>
